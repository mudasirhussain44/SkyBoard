# Local Postgres se chalane ke liye ye values fill karein
DB_USER=postgres
DB_HOST=localhost
DB_NAME=airline_db
DB_PASSWORD=your_password_here
DB_PORT=5432

# Deploy karte waqt (Render / Railway / Neon) is ek variable se hi kaam chal jayega:
